# Python bytecode and test/lint caches
__pycache__/
*.py[cod]
*.pyd
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv\**
.venv/*
venv/
env/
ENV/
pyvenv.cfg

# Local secrets and environment configuration
.env
.env.*
!.env.example
!.env.*.example

# Python packaging and build outputs
.Python
build/
dist/
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/
*.manifest

# Android and Gradle generated files
**/.gradle/
**/.kotlin/
**/build/
**/captures/
local.properties
**/local.properties
**/output-metadata.json
*.apk
*.aab
*.ap_
*.dex
*.class

# Android signing keys and local signing configuration
*.jks
*.keystore
key.properties

# PyInstaller diagnostic output (keep .spec build configuration files)
warn-*.txt
xref-*.html

# Application recordings and local runtime logs
**/gravacoes/
**/recordings/
*.log

# IDE, editor, and operating-system files
.idea/
.vscode/
*.iml
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
